{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run generate",
  "outputDirectory": ".output/public",
  "installCommand": "npm install",
  "framework": "nuxtjs",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://chinatravel.world/:path*",
      "permanent": true,
      "has": [{ "type": "header", "key": "host", "value": "travelchina-mu.vercel.app" }]
    }
  ]
}
